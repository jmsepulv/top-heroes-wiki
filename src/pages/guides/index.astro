---
import Layout from '../../layouts/Layout.astro';
import { GUIDES } from '../../data/guides';
import { getPath } from '../../utils/paths';

const getCategoryColor = (category: string) => {
  switch (category) {
    case 'progression':
      return 'bg-blue-500/20 text-blue-300 border-blue-500/40';
    case 'economy':
      return 'bg-amber-500/20 text-amber-300 border-amber-500/40';
    case 'gear':
      return 'bg-purple-500/20 text-purple-300 border-purple-500/40';
    case 'guild':
      return 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40';
    default:
      return 'bg-slate-800 text-slate-300 border-slate-700';
  }
};
---

<Layout
  title="Top Heroes Strategy & Progression Guides | Meta Walkthroughs"
  description="In-depth strategy guides for Top Heroes. Castle upgrade priority checklists, ruby economy management, gear refinement sets, and weekly guild war tactics."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-semibold mb-4">
        <span>📚 Comprehensive Strategy Compendium</span>
        <span>•</span>
        <span>Verified for Patch 1.24.0</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight">
        Master Guides & Walkthroughs
      </h1>
      <p class="mt-3 text-slate-400 text-base leading-relaxed">
        Curated strategic blueprints designed to help you avoid common traps, spend your rubies efficiently, optimize equipment sets, and accelerate your account growth.
      </p>
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {GUIDES.map((guide) => (
        <a
          href={getPath(`/guides/${guide.slug}`)}
          class="group bg-slate-900/70 border border-slate-800 hover:border-amber-500/60 rounded-3xl p-6 md:p-8 backdrop-blur-md transition-all duration-300 hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class={`text-[10px] font-bold uppercase px-2.5 py-0.5 rounded-full border ${getCategoryColor(guide.category)}`}>
                {guide.category}
              </span>
              <span class="text-xs text-slate-400 font-medium">
                {guide.readTime}
              </span>
            </div>

            <h2 class="text-xl md:text-2xl font-black text-white group-hover:text-amber-400 transition-colors mb-3">
              {guide.title}
            </h2>

            <p class="text-xs md:text-sm text-slate-300 leading-relaxed mb-6">
              {guide.summary}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between text-xs font-semibold text-amber-400 group-hover:text-amber-300">
            <span>Read Complete Guide</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>


---
import Layout from '../layouts/Layout.astro';
import { PATCH_NOTES } from '../data/changelogs';
import { getPath } from '../utils/paths';

const getChangeBadge = (type: string) => {
  switch (type) {
    case 'buff':
      return 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40';
    case 'nerf':
      return 'bg-red-500/20 text-red-400 border-red-500/40';
    case 'new':
      return 'bg-amber-500/20 text-amber-400 border-amber-500/40';
    case 'rework':
      return 'bg-purple-500/20 text-purple-400 border-purple-500/40';
    default:
      return 'bg-slate-800 text-slate-300 border-slate-700';
  }
};
---

<Layout
  title="Top Heroes Patch Notes & Balance Changelog | Version History"
  description="Verified patch balance history for Top Heroes. Hero buffs, nerfs, skill reworks, and meta shifts across versions."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Game Balance & Meta Archive</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight">
        Patch Notes & Version History
      </h1>
      <p class="mt-3 text-slate-400 text-base leading-relaxed">
        Track every hero buff, nerf, and balance adjustment. All guides and lineup tier lists on this site are verified against these exact patch releases.
      </p>
    </div>

    <!-- Timeline of Patches -->
    <div class="space-y-12">
      {PATCH_NOTES.map((patch, index) => (
        <div class="relative bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 backdrop-blur-md shadow-xl">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-5 mb-6">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-xs font-black uppercase px-3 py-1 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950">
                  Version {patch.version}
                </span>
                {index === 0 && (
                  <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
                    Current Active Patch
                  </span>
                )}
              </div>
              <h2 class="text-2xl font-black text-white">{patch.title}</h2>
            </div>
            <span class="text-xs text-slate-400 font-semibold bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 shrink-0">
              Released: {patch.releaseDate}
            </span>
          </div>

          <p class="text-sm text-slate-300 mb-6 leading-relaxed bg-slate-950/60 p-4 rounded-2xl border border-slate-800/80">
            {patch.summary}
          </p>

          <!-- Changes List -->
          <div class="space-y-3">
            <h3 class="text-xs uppercase font-bold text-slate-400 tracking-wider mb-2">Adjustments Breakdown:</h3>
            {patch.changes.map((change) => (
              <div class="flex flex-col sm:flex-row sm:items-start gap-3 bg-slate-950/40 p-3.5 rounded-xl border border-slate-800/60">
                <div class="flex items-center gap-2 shrink-0">
                  <span class={`text-[10px] font-black uppercase px-2 py-0.5 rounded border ${getChangeBadge(change.type)}`}>
                    {change.type}
                  </span>
                  <span class="text-xs font-bold text-white sm:w-32 truncate">
                    {change.target}
                  </span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">
                  {change.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

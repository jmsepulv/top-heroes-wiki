---
import Layout from '../../layouts/Layout.astro';
import { HEROES } from '../../data/heroes';
import { FACTIONS } from '../../data/factions';

const factions = FACTIONS;

const getRarityBadge = (rarity: string) => {
  switch (rarity) {
    case 'mythic':
      return 'border-red-500/80 bg-red-950/60 text-red-300 shadow-sm shadow-red-500/20';
    case 'legendary':
      return 'border-amber-500/80 bg-amber-950/60 text-amber-300 shadow-sm shadow-amber-500/20';
    case 'epic':
      return 'border-purple-500/80 bg-purple-950/60 text-purple-300 shadow-sm shadow-purple-500/20';
    default:
      return 'border-slate-700 bg-slate-900 text-slate-300';
  }
};

const getFactionBadge = (faction: string) => {
  switch (faction) {
    case 'league':
      return 'bg-blue-600/30 text-blue-300 border-blue-500/40';
    case 'nature':
      return 'bg-emerald-600/30 text-emerald-300 border-emerald-500/40';
    case 'horde':
      return 'bg-red-600/30 text-red-300 border-red-500/40';
    default:
      return 'bg-slate-800 text-slate-300 border-slate-700';
  }
};
---

<Layout
  title="All Heroes Directory & Tier Rankings | Top Heroes Guide"
  description="Comprehensive hero database for Top Heroes. Detailed skill descriptions, PvP & PvE tier rankings, stat scaling, and optimal gear recommendations."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700 text-amber-400 text-xs font-semibold mb-4">
        <span>⚔️ Complete Character Compendium</span>
        <span>•</span>
        <span class="text-slate-400">{HEROES.length} Verified Heroes</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-black text-white tracking-tight">
        Heroes Directory & Tier Guide
      </h1>
      <p class="mt-3 text-slate-400 text-base leading-relaxed">
        Explore every champion in Top Heroes. Inspect their individual active and ultimate skill scalings, stat priorities, best gear sets, and synergy pairings verified for the current meta.
      </p>
    </div>

    <!-- Faction Overview Row -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      {factions.map((f) => {
        const count = HEROES.filter((h) => h.faction === f.id).length;
        return (
          <div class={`p-5 rounded-2xl border backdrop-blur-md bg-slate-900/60 ${
            f.id === 'league'
              ? 'border-blue-500/30 hover:border-blue-500/60'
              : f.id === 'nature'
              ? 'border-emerald-500/30 hover:border-emerald-500/60'
              : 'border-red-500/30 hover:border-red-500/60'
          } transition-all`}>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg font-bold text-white capitalize">{f.name} Faction</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-800 text-slate-300">
                {count} Heroes
              </span>
            </div>
            <p class="text-xs text-slate-400 leading-relaxed mb-3">
              {f.description}
            </p>
            <div class="text-[11px] font-bold text-amber-400/90 bg-slate-950/60 p-2 rounded-lg border border-slate-800">
              6-Hero Mono Aura: +25% ATK & +25% HP
            </div>
          </div>
        );
      })}
    </div>

    <!-- Hero Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {HEROES.map((hero) => {
        return (
          <a
            href={`/heroes/${hero.id}`}
            class="group bg-slate-900/70 border border-slate-800 hover:border-amber-500/50 rounded-2xl p-5 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/10 hover:-translate-y-1 flex flex-col justify-between"
          >
            <div>
              {/* Top Meta Badges */}
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class={`text-[11px] font-bold uppercase px-2 py-0.5 rounded border ${getRarityBadge(hero.rarity)}`}>
                  {hero.rarity}
                </span>
                <span class={`text-[11px] font-semibold uppercase px-2 py-0.5 rounded border ${getFactionBadge(hero.faction)}`}>
                  {hero.faction}
                </span>
              </div>

              {/* Avatar & Hero Info */}
              <div class="flex flex-col items-center text-center">
                <div class="relative w-24 h-24 rounded-2xl overflow-hidden border-2 border-slate-800 group-hover:border-amber-500 transition-colors shadow-lg bg-slate-950 mb-3">
                  <img
                    src={hero.avatar}
                    alt={hero.name}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                    loading="lazy"
                  />
                </div>
                <h2 class="text-lg font-black text-white group-hover:text-amber-400 transition-colors">
                  {hero.name}
                </h2>
                <p class="text-xs text-slate-400 italic mb-3">
                  {hero.title}
                </p>
              </div>

              {/* Roles & Damage Type */}
              <div class="flex items-center justify-center gap-2 mb-4">
                <span class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-lg capitalize font-medium">
                  {hero.role}
                </span>
                <span class="text-xs bg-slate-800 text-slate-300 px-2.5 py-1 rounded-lg capitalize font-medium">
                  {hero.damageType}
                </span>
              </div>

              {/* Tier Rankings */}
              <div class="bg-slate-950/80 border border-slate-800/80 rounded-xl p-2.5 flex items-center justify-around mb-4 text-center">
                <div>
                  <div class="text-[10px] text-slate-400 uppercase font-semibold">PvP Tier</div>
                  <div class="text-sm font-black text-amber-400">{hero.tierRankings.pvp}</div>
                </div>
                <div class="w-px h-6 bg-slate-800"></div>
                <div>
                  <div class="text-[10px] text-slate-400 uppercase font-semibold">PvE Tier</div>
                  <div class="text-sm font-black text-emerald-400">{hero.tierRankings.pve}</div>
                </div>
              </div>

              {/* Quick Skill Peek */}
              <div class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-4">
                {hero.description}
              </div>
            </div>

            {/* View Guide Button */}
            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-semibold text-amber-400 group-hover:text-amber-300">
              <span>View Builds & Skills</span>
              <span>&rarr;</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>


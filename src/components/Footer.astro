---
import { getPath } from '../utils/paths';

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-800 bg-slate-950/90 py-12 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 font-black text-sm">
            TH
          </div>
          <span class="font-bold text-white text-base tracking-wide">Top Heroes Interactive Guide</span>
        </div>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          The ultimate strategy companion for Top Heroes players. Input your hero roster to instantly discover optimal builds, synergies, and meta lineups verified for current patch versions.
        </p>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">Quick Navigation</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={getPath('/roster')} class="hover:text-amber-400 transition-colors">Interactive Roster Builder</a></li>
          <li><a href={getPath('/heroes')} class="hover:text-amber-400 transition-colors">Heroes Database</a></li>
          <li><a href={getPath('/lineups')} class="hover:text-amber-400 transition-colors">Lineup Tier List & Builds</a></li>
          <li><a href={getPath('/events')} class="hover:text-amber-400 transition-colors">Events & Reset Timers</a></li>
          <li><a href={getPath('/guides')} class="hover:text-amber-400 transition-colors">Strategy Guides</a></li>
          <li><a href={getPath('/changelog')} class="hover:text-amber-400 transition-colors">Patch Notes & Balance</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">Meta Status</h4>
        <div class="space-y-2 text-sm">
          <p class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Version: <strong>Patch 1.24.0</strong></span>
          </p>
          <p class="text-slate-500 text-xs">Last Verified: October 2026</p>
          <p class="text-slate-500 text-xs">Aura Rules: 6-Queue Formations</p>
        </div>
      </div>
    </div>

    <!-- Mandatory Disclaimer Callout -->
    <div class="border-t border-slate-800/80 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        &copy; {currentYear} Top Heroes Interactive Guide. <strong>Disclaimer:</strong> This is a fan-made guide site and is not affiliated with, endorsed, sponsored, or specifically approved by the game's publisher or developer. Game names, trademarks, logos, and artwork belong entirely to their respective copyright owners.
      </p>
      <div class="shrink-0 flex items-center gap-4">
        <span>Community Driven</span>
        <span>•</span>
        <span>Open Guide</span>
      </div>
    </div>
  </div>
</footer>

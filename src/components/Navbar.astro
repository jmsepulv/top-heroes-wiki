---
import { getPath } from '../utils/paths';
import CommandPalette from './CommandPalette';

const currentPath = Astro.url.pathname;
const isActive = (path: string) => {
  const target = getPath(path);
  return path === '/' ? currentPath === target || currentPath === target.replace(/\/$/, '') : currentPath.startsWith(target);
};
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={getPath('/')} class="flex items-center gap-3 group">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 via-red-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
        <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2l8 4.5v6.5c0 5-3.5 9.5-8 11-4.5-1.5-8-6-8-11V6.5L12 2z" />
          <path d="M12 8v8M8 12h8" />
        </svg>
      </div>
      <div>
        <span class="text-lg font-black tracking-wider uppercase text-white group-hover:text-amber-400 transition-colors">
          Top Heroes
        </span>
        <span class="text-xs block text-slate-400 font-medium tracking-normal -mt-1">
          Interactive Guide & Builder
        </span>
      </div>
    </a>

    <!-- Nav Links -->
    <nav class="hidden lg:flex items-center gap-1">
      <a
        href={getPath('/')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/') ? 'text-white bg-slate-800 shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Home
      </a>
      <a
        href={getPath('/roster')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5 ${
          isActive('/roster') ? 'text-amber-400 bg-amber-500/10 border border-amber-500/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        <span>Roster</span>
        <span class="bg-amber-500 text-black text-[9px] font-bold px-1.5 py-0.5 rounded-full uppercase tracking-wider">Builder</span>
      </a>
      <a
        href={getPath('/sandbox')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/sandbox') ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Sandbox
      </a>
      <a
        href={getPath('/heroes')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/heroes') ? 'text-white bg-slate-800 shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Heroes
      </a>
      <a
        href={getPath('/compare')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/compare') ? 'text-amber-400 bg-amber-500/10 border border-amber-500/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Compare
      </a>
      <a
        href={getPath('/lineups')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/lineups') ? 'text-white bg-slate-800 shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Lineups
      </a>
      <a
        href={getPath('/gear')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/gear') ? 'text-purple-400 bg-purple-500/10 border border-purple-500/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Gear
      </a>
      <a
        href={getPath('/progression')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/progression') ? 'text-cyan-400 bg-cyan-500/10 border border-cyan-500/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Database
      </a>
      <a
        href={getPath('/events')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all flex items-center gap-1.5 ${
          isActive('/events') ? 'text-emerald-400 bg-emerald-500/10 border border-emerald-500/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Events</span>
      </a>
      <a
        href={getPath('/calculators')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/calculators') ? 'text-amber-400 bg-amber-500/10 border border-amber-500/30' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Calculators
      </a>
      <a
        href={getPath('/guides')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/guides') ? 'text-white bg-slate-800 shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Guides
      </a>
      <a
        href={getPath('/changelog')}
        class={`px-2.5 py-1.5 rounded-lg text-sm font-medium transition-all ${
          isActive('/changelog') ? 'text-white bg-slate-800 shadow-sm' : 'text-slate-300 hover:text-white hover:bg-slate-800/50'
        }`}
      >
        Patch
      </a>
    </nav>

    <!-- Search, Patch Badge & CTA -->
    <div class="flex items-center gap-2.5">
      <!-- Quick Search Trigger Button -->
      <button
        type="button"
        id="search-trigger-btn"
        class="flex items-center gap-2 px-2.5 py-1.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 text-xs text-slate-400 hover:text-white transition-all shadow-sm group"
        title="Search wiki (Ctrl+K or /)"
      >
        <svg class="w-3.5 h-3.5 text-amber-400 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="hidden md:inline font-medium">Search...</span>
        <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 rounded bg-slate-950 border border-slate-800 text-[10px] font-bold text-slate-500 group-hover:text-amber-400 transition-colors">
          Ctrl K
        </kbd>
      </button>

      <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Patch 1.24.0 Live
      </div>
      <a
        href={getPath('/roster')}
        class="bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 font-bold text-xs uppercase tracking-wider px-3.5 py-2 rounded-lg shadow-md shadow-orange-500/20 transition-all hover:scale-105"
      >
        Check Lineups
      </a>
    </div>
  </div>

  <!-- Global Command Palette Component -->
  <CommandPalette client:load />
</header>

<script>
  document.getElementById('search-trigger-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-command-palette'));
  });
</script>

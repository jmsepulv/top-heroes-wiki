---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Top Heroes Interactive Guide & Roster Builder',
  description = 'Interactive Top Heroes guide, roster recommendations, synergy calculators, hero skill builds, and meta tier lists verified for the latest patch.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased selection:bg-amber-500 selection:text-slate-950">
    <!-- Ambient background atmospheric glow -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
      <div class="absolute -top-[20%] left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-indigo-900/20 via-amber-600/10 to-transparent blur-3xl opacity-70"></div>
      <div class="absolute top-[40%] -left-[10%] w-[600px] h-[600px] bg-emerald-950/20 rounded-full blur-3xl"></div>
      <div class="absolute top-[60%] -right-[10%] w-[600px] h-[600px] bg-red-950/20 rounded-full blur-3xl"></div>
    </div>

    <Navbar />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
